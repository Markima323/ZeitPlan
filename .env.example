SERVER_NAME=your-domain.example.com
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/zeitplan
SPRING_DATASOURCE_USERNAME=zeitplan
SPRING_DATASOURCE_PASSWORD=change-me
APP_CORS_ALLOWED_ORIGINS=https://your-domain.example.com
APP_PUBLIC_BASE_URL=https://your-domain.example.com
APP_DICE_ROLL_ZONE=Europe/Berlin
APP_DICE_TEST_MODE=false
APP_AUTH_PASSWORD=change-this-site-password
APP_AUTH_COOKIE_SECRET=replace-this-with-a-long-random-secret
APP_AUTH_COOKIE_NAME=zeitplan_session
APP_AUTH_COOKIE_DURATION_DAYS=90
APP_AUTH_SECURE_COOKIE=true
APP_KINDLE_SIGNING_SECRET=replace-this-with-another-long-random-secret
APP_KINDLE_ZONE=Europe/Berlin
POSTGRES_DB=zeitplan
POSTGRES_USER=zeitplan
POSTGRES_PASSWORD=change-me
